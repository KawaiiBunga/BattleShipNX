diff --git a/cmake/dependencies/switch.cmake b/cmake/dependencies/switch.cmake
new file mode 100644
index 00000000..ae8588ae
--- /dev/null
+++ b/cmake/dependencies/switch.cmake
@@ -0,0 +1,87 @@
+include(FetchContent)
+
+# Nintendo Switch (devkitA64 + libnx). SDL2, Mesa (EGL/GLESv2/glapi/drm_nouveau),
+# tinyxml2 and zlib come from devkitPro portlibs; everything portlibs lacks is
+# fetched and built statically, mirroring android.cmake.
+
+#=================== SDL2 ===================
+find_package(SDL2 REQUIRED)
+
+#=================== nlohmann-json ===================
+find_package(nlohmann_json QUIET)
+if (NOT ${nlohmann_json_FOUND})
+    FetchContent_Declare(
+        nlohmann_json
+        GIT_REPOSITORY https://github.com/nlohmann/json.git
+        GIT_TAG v3.12.0
+        OVERRIDE_FIND_PACKAGE
+    )
+    FetchContent_MakeAvailable(nlohmann_json)
+endif()
+
+#=================== tinyxml2 ===================
+# Always fetched rather than taken from portlibs: the game links Torch into
+# the same binary, and Torch FetchContent's tinyxml2 too. Declaring it here
+# first makes Torch's declaration a no-op, so both share one copy instead of
+# colliding at link time.
+set(tinyxml2_BUILD_TESTING OFF)
+FetchContent_Declare(
+    tinyxml2
+    GIT_REPOSITORY https://github.com/leethomason/tinyxml2.git
+    GIT_TAG 11.0.0
+    OVERRIDE_FIND_PACKAGE
+)
+FetchContent_MakeAvailable(tinyxml2)
+if (NOT TARGET tinyxml2::tinyxml2)
+    add_library(tinyxml2::tinyxml2 ALIAS tinyxml2)
+endif()
+
+#=================== spdlog ===================
+find_package(spdlog QUIET)
+if (NOT ${spdlog_FOUND})
+    FetchContent_Declare(
+        spdlog
+        GIT_REPOSITORY https://github.com/gabime/spdlog.git
+        GIT_TAG v1.16.0
+        OVERRIDE_FIND_PACKAGE
+    )
+    FetchContent_MakeAvailable(spdlog)
+endif()
+
+#=================== libzip ===================
+find_package(libzip QUIET)
+if (NOT ${libzip_FOUND})
+    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
+    set(BUILD_TOOLS OFF)
+    set(BUILD_REGRESS OFF)
+    set(BUILD_EXAMPLES OFF)
+    set(BUILD_DOC OFF)
+    set(BUILD_OSSFUZZ OFF)
+    set(BUILD_SHARED_LIBS OFF)
+    # Only deflate (zlib) is needed for .o2r archives; keep the other codecs
+    # and crypto backends out so nothing probes for libs libnx doesn't have.
+    set(ENABLE_BZIP2 OFF)
+    set(ENABLE_LZMA OFF)
+    set(ENABLE_ZSTD OFF)
+    set(ENABLE_OPENSSL OFF)
+    set(ENABLE_GNUTLS OFF)
+    set(ENABLE_MBEDTLS OFF)
+    set(ENABLE_COMMONCRYPTO OFF)
+    set(ENABLE_WINDOWS_CRYPTO OFF)
+    FetchContent_Declare(
+        libzip
+        GIT_REPOSITORY https://github.com/nih-at/libzip.git
+        GIT_TAG v1.11.4
+        OVERRIDE_FIND_PACKAGE
+    )
+    FetchContent_MakeAvailable(libzip)
+    list(APPEND ADDITIONAL_LIB_INCLUDES ${libzip_SOURCE_DIR}/lib ${libzip_BINARY_DIR})
+endif()
+
+#=================== ImGui ===================
+# Mesa's GLES3/EGL headers live in portlibs, which the toolchain file does not
+# put on the include path; SDL2's config only adds include/SDL2.
+target_include_directories(ImGui SYSTEM PUBLIC ${DEVKITPRO}/portlibs/switch/include)
+# Static-link order matters: GLESv2 -> EGL -> glapi -> drm_nouveau -> nx.
+target_link_libraries(ImGui PUBLIC SDL2::SDL2 GLESv2 EGL glapi drm_nouveau nx)
+add_compile_definitions(IMGUI_IMPL_OPENGL_ES3)
